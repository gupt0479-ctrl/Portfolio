{
  "enabled": true,
  "name": "Orby Accessibility Guard",
  "description": "After editing any Orby component, verify that the component maintains aria-hidden=\"true\", pointer-events: none, and has no focusable or interactive elements. Check that reduced-motion is respected.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/components/orby/**/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the edited Orby file for accessibility compliance. Verify: 1) The root wrapper has aria-hidden=\"true\". 2) All elements have pointer-events: none (either via Tailwind class or CSS). 3) No focusable elements (buttons, links, inputs) exist inside the Orby tree. 4) No aria-live regions or role=\"alert\" on speech clouds. 5) prefers-reduced-motion is handled — animations are disabled and a static fallback is shown. If any violation is found, fix it immediately."
  }
}