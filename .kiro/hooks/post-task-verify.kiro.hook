{
  "enabled": true,
  "name": "Post-Task Verification",
  "description": "After completing a spec task, run typecheck and test suite to catch regressions immediately",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "pnpm typecheck && pnpm test --run"
  }
}