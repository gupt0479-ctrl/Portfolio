{
  "enabled": false,
  "name": "Orby Layout Integration Guard",
  "description": "Before writing to layout.tsx, verify the Orby integration does not break existing provider tree structure, sidebar functionality, or introduce render-blocking imports. DISABLED: This hook triggers on ALL write operations project-wide causing friction. Re-enable only when actively working on layout.tsx Orby integration.",
  "version": "2",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/app/layout.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The layout.tsx was just edited. Verify: 1) Orby is lazy-loaded (dynamic import or Suspense boundary). 2) Orby is rendered near SidebarToggle, not inside the main content flow. 3) The existing ClerkProvider, ThemeProvider, SidebarProvider, AppSidebar, and SanityLive wrappers are not disturbed. 4) No synchronous heavy imports are added to layout."
  }
}