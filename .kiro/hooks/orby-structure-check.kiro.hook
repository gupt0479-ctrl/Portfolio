{
  "enabled": true,
  "name": "Orby Structure Validator",
  "description": "After creating any new Orby file, verify the file matches the expected component structure from ORBY.md spec and the orby-companion steering file. Ensure naming conventions and export patterns are correct.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "src/components/orby/**/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new Orby file was created. Verify it follows the project conventions: 1) Uses \"use client\" directive (Orby components need hooks/browser APIs). 2) Named export, not default export. 3) Uses Tailwind utilities for styling, no separate CSS files. 4) TypeScript types are in orby.types.ts, constants in orby.constants.ts. 5) Follows the file structure from the orby-companion steering rule. 6) No new dependencies introduced. If issues are found, fix them."
  }
}