{
  "enabled": true,
  "name": "Hero Clutter Prevention",
  "description": "After editing any Hero/About section component, verify no removed elements were accidentally reintroduced and no semicolons were added",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/components/sections/HeroContent.tsx",
      "src/components/sections/ProfileImage.tsx",
      "src/components/sections/AboutSection.tsx",
      "src/components/HeroTerminal.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A Hero/About component was just edited. Quick sanity check: 1) Verify NO 'Next.js' or 'AI/ML' orbit-chip badges exist in ProfileImage. 2) Verify NO online status bar ('Online' text with green dot) exists in ProfileImage. 3) Verify NO technology line 'NEXT.JS • SANITY • 3D • TYPESCRIPT' exists in HeroContent. 4) Verify HeroTerminal is NOT imported or rendered inside AboutSection. 5) Verify no semicolons at end of statements (Biome rule). If any violation is found, fix it."
  }
}